# Optional: override the default watch folder.
# Default: ${HOME}/Library/Mobile Documents/com~apple~CloudDocs/docs
# WATCH_DIR_HOST=/Users/you/Documents/incoming-pdfs

# Optional: qwen3:4b fits typical Docker Desktop memory limits better than 14b.
OLLAMA_MODEL=qwen3:4b

# Optional: OCR only the first N pages. Set to 0 to OCR every page.
OCR_MAX_PAGES=3

# Optional: long-running scanned PDFs and local model inference can be slow.
SURYA_TIMEOUT_SECONDS=1200
OLLAMA_TIMEOUT_SECONDS=1200

# Optional: Surya OCR can need swap for scanned or unusually tall pages.
# SURYA_MEMSWAP_LIMIT is total memory plus swap, not swap alone.
SURYA_MEM_LIMIT=8g
SURYA_MEMSWAP_LIMIT=20g
